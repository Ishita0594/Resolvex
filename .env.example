# ResolveX local development only.
# Change all credentials outside local development.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resolvex_dev
POSTGRES_USER=resolvex_dev
POSTGRES_PASSWORD=resolvex_dev_password

BACKEND_PORT=3000
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

JWT_SECRET=replace_with_real_local_development_secret
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
DISPUTE_MERCHANT_RESPONSE_DAYS=7
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/evidence
MAX_EVIDENCE_FILE_SIZE_BYTES=10485760
EVIDENCE_UPLOAD_URL_TTL_SECONDS=600
EVIDENCE_DOWNLOAD_URL_TTL_SECONDS=300
API_PUBLIC_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000
AI_SERVICE_RETRY_ATTEMPTS=2
AI_SERVICE_RETRY_BACKOFF_MS=150
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_MAX=120
POLICY_AUTO_CONFIDENCE_THRESHOLD=85
POLICY_AUTO_DECISION_MARGIN_THRESHOLD=20
POLICY_CRITICAL_FACT_CONFIDENCE_THRESHOLD=0.8
OCR_PROVIDER=local
AWS_REGION=us-east-1
# S3_BUCKET_NAME is accepted as a deployment-friendly alias for AWS_S3_BUCKET.
S3_BUCKET_NAME=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_TEXTRACT_ENABLED=false
SPACY_MODEL=blank:en
HF_CLASSIFICATION_ENABLED=false
HF_CLASSIFICATION_MODEL=distilbert-base-uncased-finetuned-sst-2-english
MAX_DOCUMENT_BYTES=10485760

# Demo seed passwords for local development prototypes only.
# If omitted, the backend seed script uses the documented development-only fallback: ResolveXDemo123!
RESOLVEX_DEMO_PASSWORD=
RESOLVEX_DEMO_MEMBER_PASSWORD=
RESOLVEX_DEMO_MERCHANT_PASSWORD=
RESOLVEX_DEMO_ANALYST_PASSWORD=
