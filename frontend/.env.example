VITE_API_BASE_URL=http://localhost:3000/api
# Optional: only set this if the realtime gateway is hosted on a different origin
# than the REST API. Leave unset to derive it from VITE_API_BASE_URL.
# VITE_WS_BASE_URL=http://localhost:3000
VITE_APP_NAME=ResolveX
# Optional: shows a small badge in the app and on the login screen (e.g. "Hackathon Demo").
# Leave unset for a production-looking build.
VITE_DEMO_MODE_LABEL=Hackathon Demo
